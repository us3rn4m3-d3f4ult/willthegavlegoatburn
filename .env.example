# Copy to .env.local and fill in. Committed file — no real secrets here.

# ── Chain ────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_RPC_URL=
# The GavleGoatMarket (CLOB) the site actually reads. docs/ORDERBOOK.md lists
# the older deployments and what is still live.
NEXT_PUBLIC_BOOK_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ── Contract deployment (see docs/DEPLOY_CONTRACT.md) ────────
# Used by scripts/deploy_*.py. Real values live in .env.deploy, which is
# gitignored — never put a private key in this file.
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=
RESOLVER_ADDRESS=
BETTING_CLOSES_AT=
RESOLUTION_DEADLINE=
BASESCAN_API_KEY=

# ── Auth (server only) ───────────────────────────────────────
DATABASE_URL=postgresql://gavle:gavle@localhost:5432/gavle
# Peppers recovery-code hashes. Rotating it invalidates every issued code.
SESSION_SECRET=

# ── Email (verification) ────────────────────────────────────
# Blank key = no verification mail; accounts stay unverified and nothing is
# gated. REQUIRE_VERIFIED_EMAIL=1 also blocks unverified accounts from
# commenting — only set it once a test email actually arrives. docs/EMAIL.md.
RESEND_API_KEY=
MAIL_FROM=willthegavlegoatburn <noreply@willthegavlegoatburn.com>
REQUIRE_VERIFIED_EMAIL=0

# ── GIFs in comments ─────────────────────────────────────────
# Free GIPHY key from developers.giphy.com. This one IS public: GIPHY requires
# the search call to be made from the browser, which is why it is NEXT_PUBLIC_.
# Leave blank and the GIF button simply does not appear.
NEXT_PUBLIC_GIPHY_API_KEY=

# ── Wallet ──────────────────────────────────────────────────
# WalletConnect project id, used for the mobile connect flow.
NEXT_PUBLIC_WC_PROJECT_ID=

# ── Ops ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://willthegavlegoatburn.com
# Origin sent on server-side RPC calls; must match the Alchemy allowlist entry.
NEXT_PUBLIC_SITE_ORIGIN=https://willthegavlegoatburn.com

# "maintenance" gates every page behind /maintenance + the email capture.
# Anything else (or unset) and the market is public.
SITE_MODE=live
