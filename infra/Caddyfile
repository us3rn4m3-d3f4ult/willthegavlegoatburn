# ─────────────────────────────────────────────────────────────
# Caddy — TLS + security headers. Two modes, pick ONE:
#
#  A) Cloudflare PROXIED (recommended): use a Cloudflare Origin
#     Certificate. Put origin.pem / origin.key in ./certs and keep
#     the `tls` line below. Cloudflare SSL/TLS mode = Full (strict).
#
#  B) Cloudflare DNS-ONLY (grey cloud): comment out the `tls` line
#     and Caddy fetches a Let's Encrypt cert itself over HTTP-01.
#     Your origin IP becomes public.
# ─────────────────────────────────────────────────────────────

{
  admin off
  email contact@willthegavlegoatburn.com
  servers {
    protocols h1 h2 h3
  }
}

willthegavlegoatburn.com {
  encode zstd gzip

  # Default: Caddy fetches its own Let's Encrypt cert. This works fine with
  # Cloudflare proxying ON, and satisfies SSL mode "Full (strict)" because a
  # publicly-trusted cert is presented at the origin.
  #
  # Optional upgrade — pin a Cloudflare Origin Certificate instead (15-year
  # validity, no external issuance). Download it from
  #   SSL/TLS → Origin Server → Create Certificate
  # save as infra/certs/origin.pem + origin.key, then uncomment:
  #
  # tls /certs/origin.pem /certs/origin.key

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    -Server
  }

  # Credential-endpoint rate limiting is done at Cloudflare (WAF rate rules)
  # because `rate_limit` needs the xcaddy-built plugin, not stock caddy:2-alpine.
  # If you later build a custom Caddy image, add it here.

  reverse_proxy web:3000 {
    header_up X-Real-IP {http.request.header.CF-Connecting-IP}
    header_up X-Forwarded-Proto https
  }

  handle_errors {
    respond "{err.status_code} {err.status_text}" {err.status_code}
  }
}


www.willthegavlegoatburn.com {
  redir https://willthegavlegoatburn.com{uri} permanent
}
