# ─────────────────────────────────────────────────────────────
# Caddy — TLS + security headers. Two modes, pick ONE:
#
#  A) Cloudflare PROXIED (recommended): use a Cloudflare Origin
#     Certificate. Put origin.pem / origin.key in ./certs and keep
#     the `tls` line below. Cloudflare SSL/TLS mode = Full (strict).
#
#  B) Cloudflare DNS-ONLY (grey cloud): comment out the `tls` line
#     and Caddy fetches a Let's Encrypt cert itself over HTTP-01.
#     Your origin IP becomes public.
# ─────────────────────────────────────────────────────────────

{
  admin off
  email contact@willthegavlegoatburn.com
  servers {
    protocols h1 h2 h3
  }
}

willthegavlegoatburn.com {
  encode zstd gzip

  # Cloudflare Origin Certificate — valid to 2041, covers
  # willthegavlegoatburn.com and *.willthegavlegoatburn.com.
  # Requires infra/certs/origin.pem + origin.key on the host (gitignored).
  # Regenerate at SSL/TLS → Origin Server in the Cloudflare dashboard.
  # Without these files Caddy will fail to start — intentional, so a missing
  # certificate is never a silent downgrade to HTTP.
  tls /certs/origin.pem /certs/origin.key

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    -Server
  }

  # Documents are never cacheable. A page carries the content hashes of the build
  # it came from, so one served across a deploy asks for chunks that no longer
  # exist and React shows "Application error: a client-side exception has
  # occurred". Next sets an aggressive s-maxage on these, so override it here.
  @document not path /_next/static/* /favicon.ico /icon.svg /apple-icon.png /opengraph-image*
  header @document Cache-Control "no-store, must-revalidate"

  # Hashed build output is the opposite case: the name changes when the bytes do.
  @immutable path /_next/static/*
  header @immutable Cache-Control "public, max-age=31536000, immutable"

  # Credential-endpoint rate limiting is done at Cloudflare (WAF rate rules)
  # because `rate_limit` needs the xcaddy-built plugin, not stock caddy:2-alpine.
  # If you later build a custom Caddy image, add it here.

  reverse_proxy web:3000 {
    # Only trust forwarding headers from Cloudflare's edge. The previous config did
    # `header_up X-Real-IP {http.request.header.CF-Connecting-IP}`, which copied a
    # header the *client* controls: anyone reaching the origin directly (ufw allows
    # 443 from anywhere) could rotate CF-Connecting-IP per request and never trip
    # the login rate limiter. With trusted_proxies, {client_ip} uses the forwarded
    # value only when the TCP peer is really Cloudflare, and the peer address
    # otherwise. Keep this list in sync with cloudflare.com/ips.
    trusted_proxies 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
      141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 \
      198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 \
      131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
      2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    header_up X-Real-IP {client_ip}
    header_up X-Forwarded-Proto https
  }

  handle_errors {
    respond "{err.status_code} {err.status_text}" {err.status_code}
  }
}


www.willthegavlegoatburn.com {
  redir https://willthegavlegoatburn.com{uri} permanent
}
